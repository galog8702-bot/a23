<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registro de Donantes</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>

    <div class="contenedor">

        <h1>Registro de Donantes</h1>
        <p>Completa tus datos para registrarte como posible donante.</p>

        <form id="formularioDonante">

            <label for="nombre">Nombre completo</label>
            <input 
                type="text" 
                id="nombre" 
                placeholder="Ej: Juan Pérez"
                required
            >

            <label for="sangre">Tipo de sangre</label>
            <select id="sangre" required>
                <option value="">Seleccionar</option>
                <option value="A+">A+</option>
                <option value="A-">A-</option>
                <option value="B+">B+</option>
                <option value="B-">B-</option>
                <option value="AB+">AB+</option>
                <option value="AB-">AB-</option>
                <option value="O+">O+</option>
                <option value="O-">O-</option>
            </select>

            <label for="telefono">Número de teléfono</label>
            <input 
                type="tel" 
                id="telefono" 
                placeholder="Ej: 11 1234 5678"
                required
            >

            <label>¿Estás dispuesto/a a donar?</label>

            <div class="opciones">
                <label>
                    <input type="radio" name="donar" value="Sí" required>
                    Sí
                </label>

                <label>
                    <input type="radio" name="donar" value="No">
                    No
                </label>
            </div>

            <button type="submit">Registrar donante</button>

        </form>

        <div id="mensaje"></div>

        <h2>Donantes registrados</h2>

        <table>
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Sangre</th>
                    <th>Teléfono</th>
                    <th>¿Dona?</th>
                </tr>
            </thead>

            <tbody id="listaDonantes">
            </tbody>
        </table>

    </div>

    <script src="script.js"></script>

</body>
</html>
